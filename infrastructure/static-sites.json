{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Calopi Haven: private S3, three CloudFront distributions and Route 53 zones",
  "Parameters": {
    "EnableCustomDomains": {
      "Type": "String",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "false"
    },
    "CertificateArn": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "CustomDomains": {
      "Fn::Equals": [
        {
          "Ref": "EnableCustomDomains"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "SitesBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "ticosync-calopihaven-sites-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "calopihaven"
          }
        ]
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SecurityHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-headers"
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "strict-origin-when-cross-origin",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "IncludeSubdomains": false,
              "Preload": false,
              "Override": true
            }
          }
        }
      }
    },
    "CalopiZone": {
      "Type": "AWS::Route53::HostedZone",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "calopihaven.com",
        "HostedZoneConfig": {
          "Comment": "Calopi Haven public DNS; existing email and guest guides preserved before delegation"
        },
        "HostedZoneTags": [
          {
            "Key": "Application",
            "Value": "calopihaven"
          }
        ]
      }
    },
    "CalopiRedirect": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-calopi-www"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Redirect www to the canonical apex; preserve query strings",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) { var r=event.request; if(r.headers.host.value==='www.calopihaven.com'){var q=[];for(var k in r.querystring){var p=r.querystring[k];(p.multiValue||[p]).forEach(function(v){q.push(encodeURIComponent(k)+'='+encodeURIComponent(v.value));});}return {statusCode:301,statusDescription:'Moved Permanently',headers:{location:{value:'https://calopihaven.com'+r.uri+(q.length?'?'+q.join('&'):'')}}};}return r;}"
      }
    },
    "CalopiCDN": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Calopi Haven: calopihaven.com",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Aliases": {
            "Fn::If": [
              "CustomDomains",
              [
                "calopihaven.com",
                "www.calopihaven.com"
              ],
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          "ViewerCertificate": {
            "Fn::If": [
              "CustomDomains",
              {
                "AcmCertificateArn": {
                  "Ref": "CertificateArn"
                },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {
                "CloudFrontDefaultCertificate": true
              }
            ]
          },
          "Origins": [
            {
              "Id": "PrivateS3",
              "DomainName": {
                "Fn::GetAtt": [
                  "SitesBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginPath": "/calopihaven.com",
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "PrivateS3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": {
              "Ref": "SecurityHeaders"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "CalopiRedirect",
                    "FunctionARN"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "CalopiApexA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "CalopiZone"
        },
        "Name": "calopihaven.com",
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "CalopiCDN",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
